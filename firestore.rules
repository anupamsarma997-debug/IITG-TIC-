rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default safety net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Properties Collection: Publicly readable; authentic hosts manage their own listings
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Rooms Collection: Publicly readable; authentic hosts manage their room inventory
    match /rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Booking Enquiries Collection: Publicly submit & host enquiry tracking
    match /enquiries/{enquiryId} {
      allow create, read, update, delete: if true;
    }

    // Banners Collection: Publicly readable; advertisers manage campaigns
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Users Collection: User management
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}

