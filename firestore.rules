rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Catch-all safety net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Properties Collection: Publicly readable; authentic hosts can write
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.title is string && request.resource.data.city is string;
      allow update, delete: if isSignedIn() && (
        !('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid
      );
    }

    // Rooms Collection: Publicly readable for property guests; hosts can manage rooms
    match /rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Booking Enquiries Collection: Guests can post enquiries; authentic users can manage leads
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Banners Collection: Publicly readable; advertisers/admins can write
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Users Collection: Users can manage their own profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }
  }
}
