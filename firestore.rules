rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default safety net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Properties Collection: Publicly readable; hosts can create & manage their own listings
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        !('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid
      );
    }

    // Rooms Collection: Publicly readable; hosts can manage room inventory for their properties
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        !('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid
      );
    }

    // Booking Enquiries Collection: Guests can create; host & guest access isolation
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && (
        !('hostUid' in resource.data) || resource.data.hostUid == request.auth.uid ||
        !('guestUid' in resource.data) || resource.data.guestUid == request.auth.uid
      );
    }

    // Banners Collection: Publicly readable; advertisers manage their own campaigns
    match /banners/{bannerId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        !('advertiserUid' in request.resource.data) || request.resource.data.advertiserUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        !('advertiserUid' in resource.data) || resource.data.advertiserUid == request.auth.uid
      );
    }

    // Users Collection: Strict user profile privacy (users can only access their own user document)
    match /users/{userId} {
      allow read, write: if isUser(userId);
    }
  }
}
