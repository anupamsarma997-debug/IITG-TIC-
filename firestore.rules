rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default safety net: Deny all unhandled operations
    match /{document=**} {
      allow read, write: if false;
    }

    // Properties Collection: Publicly readable; strictly authenticated owners manage ONLY their own property listings
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == ('google_' + request.auth.uid) ||
        request.resource.data.ownerId == ('user_' + request.auth.uid)
      );
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerId == ('google_' + request.auth.uid) ||
        resource.data.ownerId == ('user_' + request.auth.uid)
      );
    }

    // Rooms Collection: Publicly readable; strictly authenticated owners manage room inventory for THEIR properties
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == ('google_' + request.auth.uid) ||
        request.resource.data.ownerId == ('user_' + request.auth.uid)
      );
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerId == ('google_' + request.auth.uid) ||
        resource.data.ownerId == ('user_' + request.auth.uid)
      );
    }

    // Booking Enquiries Collection: Anyone can submit an enquiry; access restricted to involved host/guest
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && (
        !('hostUid' in resource.data) || resource.data.hostUid == request.auth.uid ||
        !('guestUid' in resource.data) || resource.data.guestUid == request.auth.uid ||
        resource.data.hostId == request.auth.uid
      );
    }

    // Banners Collection: Publicly readable; advertisers manage their own promotional campaigns
    match /banners/{bannerId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.advertiserUid == request.auth.uid ||
        request.resource.data.advertiserId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.advertiserUid == request.auth.uid ||
        resource.data.advertiserId == request.auth.uid
      );
    }

    // Users Collection: Users manage their own profile documents
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isUser(userId);
    }
  }
}



